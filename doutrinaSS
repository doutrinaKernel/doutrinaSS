def hit(msg, level="CRIT"):
    if level == "CRIT":
        console.print(f"  [{BLOOD2}]◆[/{BLOOD2}] [{GOLD}]{msg}[/{GOLD}]")
    elif level == "WARN":
        console.print(f"  [{GOLD}]◇[/{GOLD}] [{BLOOD2}]{msg}[/{BLOOD2}]")
    else:
        console.print(f"  [{DIM}]·[/{DIM}] {msg}")

def clean(msg):
    console.print(f"  [{DIM}]○[/{DIM}] {msg}")

def ensure_chafa():
    """instala chafa automaticamente se não existir (Termux)"""
    try:
        r = subprocess.run(["chafa", "--version"], capture_output=True, timeout=5)
        if r.returncode == 0:
            return True
    except Exception:
        pass

    console.print(Text("  instalando chafa...", style=DIM))
    try:
        r = subprocess.run(
            ["pkg", "install", "-y", "chafa"],
            capture_output=True, text=True, timeout=120
        )
        if r.returncode == 0:
            return True
    except Exception:
        pass

    try:
        r = subprocess.run(
            ["apt", "install", "-y", "chafa"],
            capture_output=True, text=True, timeout=120
        )
        if r.returncode == 0:
            return True
    except Exception:
        pass

    return False

