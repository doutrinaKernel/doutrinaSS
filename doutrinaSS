# ─── coleta de dumps para o .zip ─────────────────────────────

def collect_dumps():
    os.makedirs(DUMP_DIR, exist_ok=True)
    files = []

    dumps = {
        "01_top.txt":            "top -b -n 1",
        "02_ps_A.txt":           "ps -A",
        "03_cpuinfo.txt":        "dumpsys cpuinfo",
        "04_batterystats.txt":   "dumpsys batterystats",
        "05_meminfo.txt":        "dumpsys meminfo",
        "06_activity.txt":       "dumpsys activity activities",
        "07_package_folk.txt":   "dumpsys package me.yuki.folk",
        "08_getprop.txt":        "getprop",
        "09_uname.txt":          "uname -a",
        "10_cmdline.txt":        "cat /proc/cmdline",
        "11_events_su.txt":      "logcat -d -b events -t 500",
        "12_packagemanager.txt": "logcat -d -t 300 PackageManager:W *:S",
    }

    for fname, cmd in dumps.items():
        data = adb(cmd, timeout=20)
        path = os.path.join(DUMP_DIR, fname)
        with open(path, "w", encoding="utf-8", errors="replace") as f:
            f.write(data if data else "(empty / restricted)\n")
        files.append(path)

    root_filter = adb("dumpsys batterystats | grep -E 'Proc (apd|su|inotifyd|ssh|kikiw|magisk|apatch)' || true")
    path = os.path.join(DUMP_DIR, "13_root_procs_filter.txt")
    with open(path, "w", encoding="utf-8", errors="replace") as f:
        f.write(root_filter if root_filter else "(nenhum match)\n")
    files.append(path)

    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    zip_name = os.path.join(SCRIPT_DIR, f"doutrina_root_dump_{stamp}.zip")
    with zipfile.ZipFile(zip_name, "w", zipfile.ZIP_DEFLATED) as z:
        for p in files:
            z.write(p, os.path.basename(p))

    for p in files:
        try:
            os.remove(p)
        except Exception:
            pass
    try:
        os.rmdir(DUMP_DIR)
    except Exception:
        pass

    return zip_name

# ─── detectors ───────────────────────────────────────────────

def scan_packages():
    found = []
    targets = [
        "me.yuki.folk",
        "me.bmax.apatch",
        "me.bmax.apatch.ui",
        "com.apatch",
    ]
    pkgs = adb("pm list packages -f")
    for t in targets:
        if t in pkgs:
            found.append(t)
            hit(f"package present → {t}", "CRIT")

    act = adb("dumpsys activity activities")
    if "me.yuki.folk" in act or "FolkPatch" in act or "me.bmax.apatch" in act:
        hit("activity residue → FolkPatch / APatch", "CRIT")
        found.append("activity_residue")

    logp = adb("logcat -d -t 200 PackageManager:W *:S")
    if "me.yuki.folk" in logp and "Missing required system package" in logp:
        hit("PackageManager extended search hit (me.yuki.folk)", "CRIT")
        found.append("pm_warning")

    if not found:
        clean("no known patch manager packages")
    return found

def scan_kernel():
    found = []
    uname = adb("uname -a")
    if uname.strip():
        console.print(f"  [{DIM}]kernel[/{DIM}] {uname.strip()[:90]}")

    cmdl = adb("cat /proc/cmdline")
    if "kpti=off" in cmdl:
        hit("cmdline kpti=off", "CRIT")
        found.append("kpti_off")

    dmesg = adb("dmesg -T 2>/dev/null | tail -n 400")
    if not dmesg:
        dmesg = adb("cat /proc/kmsg 2>/dev/null | tail -n 200")

    kp_hits = re.findall(r"\[?\+\]?\s*KP\s+I\s+commit_common_su", dmesg)
    if kp_hits:
        hit(f"dmesg KP commit_common_su ×{len(kp_hits)}", "CRIT")
        found.append("kp_su")

    if "selinux_hook" in dmesg and ("security_setprocattr" in dmesg or "selinux_setprocattr" in dmesg):
        hit("selinux_hook activity detected", "CRIT")
        found.append("selinux_hook")

    if not found:
        clean("kernel surface clean (or restricted)")
    return found

def scan_procs():
    found = []
    top    = adb("top -b -n 1")
    cpu    = adb("dumpsys cpuinfo")
    batt   = adb("dumpsys batterystats")
    events = adb("logcat -d -b events -t 400")

    if re.search(r"\bapd\b", top) or re.search(r"\bapd\b", cpu) or "Proc apd:" in batt:
        hit("process leak → apd", "CRIT")
        found.append("apd")

    if "ssh.sh" in top or "ssh.sh" in events:
        hit("process leak → ssh.sh", "CRIT")
        found.append("ssh.sh")

    if "PhantomProcessRecord" in events and re.search(r":su/\d+", events):
        hit("PhantomProcessRecord su", "CRIT")
        found.append("su_phantom")

    if "Proc kikiw:" in batt:
        hit("historical → Proc kikiw", "WARN")
        found.append("kikiw")

    for name in ["apd", "ssh.sh"]:
        if re.search(rf",{name},", events) or re.search(rf"\b{name}\b", events):
            if name not in found:
                hit(f"am_cpu event → {name}", "CRIT")
                found.append(name)

    if "apd" in found and "su_phantom" in found:
        hit("pid correlation apd ↔ su", "CRIT")

    if re.search(r"\binotifyd\b", top) and "Proc inotifyd:" in batt:
        if found:
            hit("inotifyd residual (contexto root)", "WARN")
            found.append("inotifyd")

    if "Proc su:" in batt and ("su_phantom" in found or "apd" in found):
        hit("batterystats → Proc su (correlacionado)", "CRIT")
        found.append("su_batt")

    if not found:
        clean("no root process residue")
    return found

def scan_hide():
    found = []
    ps  = adb("ps -A")
    top = adb("top -b -n 1")
    for name in ["apd", "ssh.sh", "kikiw"]:
        if name in top and name not in ps:
            hit(f"hide signature → {name} (top sim / ps não)", "CRIT")
            found.append(f"hide_{name}")
    if not found:
        clean("no hide discrepancy observed")
    return found

def scan_boot():
    props = adb("getprop")
    locked = []
    for key in ["ro.boot.flash.locked", "ro.boot.vbmeta.device_state",
                "ro.boot.verifiedbootstate", "sys.oem_unlock_allowed"]:
        m = re.search(rf"\[{re.escape(key)}\]:\s*\[([^\]]+)\]", props)
        if m:
            locked.append(f"{key}={m.group(1)}")
    if locked:
        console.print(f"  [{DIM}]boot[/{DIM}] " + " | ".join(locked))
    return []

def scan_extra():
    found = []
    artd = adb("logcat -d -t 100 artd:I *:S")
    if "me.yuki.folk" in artd and "base.odex" in artd:
        hit("artd odex residue → me.yuki.folk", "CRIT")
        found.append("artd_odex")
    return found

