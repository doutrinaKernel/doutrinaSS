        console.print(Text("  nenhum indício de root ou patch de kernel encontrado", style=DIM))
    else:
        console.print(Text("  indícios de root / modificações detectados", style=f"bold {BLOOD2}"))
        console.print(Text(f"  sinais : {len(set(all_hits))}", style=GOLD))
        for s in sorted(set(all_hits)):
            console.print(f"  [{BLOOD2}]›[/{BLOOD2}] {s}")
    if zip_path and os.path.isfile(zip_path):
        console.print(Text(f"  dump gerado → {os.path.basename(zip_path)}", style=DIM))
    console.print()
    aviso = Text()
    aviso.append("AVISO: ", style=f"bold {BLOOD2}")
    aviso.append('" scanner feito para a facilitação em análises de Android com suspeita de Roots ou modificações a nível Kernel, scanner feito com o básico / intermediário de Root"', style=GOLD)
    console.print(aviso)
    console.print()
    console.print(Text("CREATOR SCANNER: doutrinaking", style=f"bold {GOLD}"))
    console.print(Text("GITHUB: doutrinaKernel", style=f"bold {GOLD}"))
    console.print()
    console.print(Text("Copyright © 2026 - 2028 doutrinaking. All rights reserved.", style=f"bold {GOLD}"))
    console.print()
    show_logo()

def main():
    clear_screen()
    banner()
    ok, devs = check_device()
    if not ok:
        console.print(Panel(Text("no device / unauthorized", style=f"bold {BLOOD2}"), border_style=BLOOD, box=box.HEAVY))
        final_block([])
        return
    console.print(Text(f"  device linked · {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}", style=DIM))
    console.print()

    all_hits = []
    zip_path = None

    with Progress(
        SpinnerColumn(style=BLOOD2),
        TextColumn("[bold]{task.description}"),
        BarColumn(bar_width=28, style=BLOOD, complete_style=GOLD),
        console=console,
        transient=True,
    ) as prog:
        t0 = prog.add_task("coletando dumps", total=1)
        zip_path = collect_dumps()
        prog.update(t0, advance=1)
        time.sleep(0.1)

        t1 = prog.add_task("kernel", total=1)
        all_hits.extend(scan_kernel())
        prog.update(t1, advance=1)
        time.sleep(0.12)

        t2 = prog.add_task("process residue", total=1)
        all_hits.extend(scan_procs())
        prog.update(t2, advance=1)
        time.sleep(0.12)

        t3 = prog.add_task("root binaries", total=1)
        all_hits.extend(scan_root_bin())
        prog.update(t3, advance=1)
        time.sleep(0.1)

        t4 = prog.add_task("strings", total=1)
        all_hits.extend(scan_strings())
        prog.update(t4, advance=1)
        time.sleep(0.1)

        t5 = prog.add_task("android 11-15", total=1)
        all_hits.extend(scan_android11_15())
        prog.update(t5, advance=1)
        time.sleep(0.08)

        t6 = prog.add_task("extra", total=1)
        all_hits.extend(scan_extra())
        prog.update(t6, advance=1)

    final_block(all_hits, zip_path)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        console.print("\n[interrupted]")
        final_block([])
