# ─── main ────────────────────────────────────────────────────

def main():
    clear_screen()
    banner()

    ok, devs = check_device()
    if not ok:
        console.print(Panel(Text("no device / unauthorized", style=f"bold {BLOOD2}"),
                            border_style=BLOOD, box=box.HEAVY))
        final_block([])
        return

    console.print(Text(f"  device linked · {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}", style=DIM))
    console.print()

    all_hits = []
    zip_path = None

    with Progress(
        SpinnerColumn(style=BLOOD2),
        TextColumn("[bold]{task.description}"),
        BarColumn(bar_width=28, style=BLOOD, complete_style=GOLD),
        console=console,
        transient=True,
    ) as prog:

        t0 = prog.add_task("coletando dumps", total=1)
        zip_path = collect_dumps()
        prog.update(t0, advance=1)
        time.sleep(0.1)

        t1 = prog.add_task("packages", total=1)
        all_hits.extend(scan_packages())
        prog.update(t1, advance=1)
        time.sleep(0.12)

        t2 = prog.add_task("kernel surface", total=1)
        all_hits.extend(scan_kernel())
        prog.update(t2, advance=1)
        time.sleep(0.12)

        t3 = prog.add_task("process residue", total=1)
        all_hits.extend(scan_procs())
        prog.update(t3, advance=1)
        time.sleep(0.12)

        t4 = prog.add_task("hide / discrepancy", total=1)
        all_hits.extend(scan_hide())
        prog.update(t4, advance=1)
        time.sleep(0.12)

        t5 = prog.add_task("boot props", total=1)
        scan_boot()
        prog.update(t5, advance=1)
        time.sleep(0.08)

        t6 = prog.add_task("extra surface", total=1)
        all_hits.extend(scan_extra())
        prog.update(t6, advance=1)

    final_block(all_hits, zip_path)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        console.print("\n[interrupted]")
        final_block([])
