def adb(cmd, timeout=25):
    full = ["adb", "shell"] + cmd if isinstance(cmd, list) else ["adb", "shell", cmd]
    try:
        r = subprocess.run(full, capture_output=True, text=True, timeout=timeout)
        out = (r.stdout or "") + (r.stderr or "")
        if any(x in out.lower() for x in ["permission denied", "not found", "inaccessible", "no such file"]):
            return ""
        return out
    except Exception:
        return ""

def adb_raw(cmd, timeout=12):
    try:
        r = subprocess.run(["adb"] + cmd, capture_output=True, text=True, timeout=timeout)
        return (r.stdout or "") + (r.stderr or "")
    except Exception:
        return ""

def check_device():
    out = adb_raw(["devices"])
    lines = [l.strip() for l in out.splitlines() if l.strip() and "List of devices" not in l]
    devs = [l for l in lines if "\tdevice" in l]
    return len(devs) > 0, devs

