def hit(msg, level="CRIT"):
    if level == "CRIT":
        console.print(f"  [{BLOOD2}]◆[/{BLOOD2}] [{GOLD}]{msg}[/{GOLD}]")
    elif level == "WARN":
        console.print(f"  [{GOLD}]◇[/{GOLD}] [{BLOOD2}]{msg}[/{BLOOD2}]")
    else:
        console.print(f"  [{DIM}]·[/{DIM}] {msg}")

def clean(msg):
    console.print(f"  [{DIM}]○[/{DIM}] {msg}")

def ensure_chafa():
    try:
        r = subprocess.run(["chafa", "--version"], capture_output=True, timeout=5)
        if r.returncode == 0: return True
    except: pass
    console.print(Text("  instalando chafa...", style=DIM))
    try:
        subprocess.run(["pkg", "install", "-y", "chafa"], capture_output=True, timeout=120)
        return True
    except: pass
    return False

