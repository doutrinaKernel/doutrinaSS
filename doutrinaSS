        console.print(Text(f"  [logo não encontrada: {LOGO_PATH}]", style=DIM))
        return
    ensure_chafa()
    attempts = [
        ["chafa", "--size", "40x", "--symbols", "block", LOGO_PATH],
        ["chafa", "-s", "40", LOGO_PATH],
        ["chafa", LOGO_PATH],
        ["timg", "-g", "40x28", LOGO_PATH],
        ["viu", "-w", "40", LOGO_PATH],
    ]
    for cmd in attempts:
        try:
            r = subprocess.run(cmd, capture_output=True, timeout=10)
            if r.returncode == 0 and (r.stdout or r.stderr):
                sys.stdout.buffer.write(r.stdout if r.stdout else r.stderr)
                sys.stdout.buffer.flush()
