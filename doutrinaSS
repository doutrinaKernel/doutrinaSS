def collect_dumps():
    os.makedirs(DUMP_DIR, exist_ok=True)
    files = []
    dumps = {
        "01_top.txt":            "top -b -n 1",
        "02_ps_A.txt":           "ps -A",
        "03_cpuinfo.txt":        "dumpsys cpuinfo",
        "04_batterystats.txt":   "dumpsys batterystats",
        "05_meminfo.txt":        "dumpsys meminfo",
        "06_activity.txt":       "dumpsys activity activities",
        "07_package_folk.txt":   "dumpsys package me.yuki.folk",
        "08_getprop.txt":        "getprop",
        "09_uname.txt":          "uname -a",
        "10_cmdline.txt":        "cat /proc/cmdline",
        "11_events.txt":         "logcat -d -b events -t 500",
        "12_packagemanager.txt": "logcat -d -t 300 PackageManager:W *:S",
        "13_dmesg.txt":          "dmesg -T 2>/dev/null | tail -n 800",
        "14_root_bin.txt":       "ls /system/bin/su /system/xbin/su /data/local/tmp/su /data/adb/su 2>/dev/null || true",
        "15_strings_su.txt":     "strings /system/bin/su 2>/dev/null | head -n 50 || true",
    }
    for fname, cmd in dumps.items():
        data = adb(cmd, timeout=30)
        path = os.path.join(DUMP_DIR, fname)
        with open(path, "w", encoding="utf-8", errors="replace") as f:
            f.write(data if data else "(empty / restricted)\n")
        files.append(path)
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    zip_name = os.path.join(SCRIPT_DIR, f"doutrina_root_dump_{stamp}.zip")
    with zipfile.ZipFile(zip_name, "w", zipfile.ZIP_DEFLATED) as z:
        for p in files:
            z.write(p, os.path.basename(p))
    for p in files:
        try: os.remove(p)
        except: pass
    try: os.rmdir(DUMP_DIR)
    except: pass
    return zip_name

def scan_kernel():
    found = []
    uname = adb("uname -a")
    if uname.strip():
        console.print(f"  [{DIM}]kernel[/{DIM}] {uname.strip()[:90]}")

    cmdl = adb("cat /proc/cmdline")
    if "kpti=off" in cmdl:
        hit("kpti=off", "CRIT")
        found.append("kpti_off")
    if "selinux_hook" in cmdl or "selinux_setprocattr" in cmdl:
        hit("selinux_hook kernel", "CRIT")
        found.append("selinux_hook")

    dmesg = adb("dmesg -T 2>/dev/null | tail -n 800")
    kp = re.findall(r"\[?\+\]?\s*KP\s+I\s+commit_common_su", dmesg)
    if kp:
        hit(f"KP commit_common_su ×{len(kp)}", "CRIT")
        found.append("kp_su")
    if re.search(r"(kpm|kpimg|susfs|kernelpatched|KernelSU)", dmesg, re.I):
        hit("kernel recompiled traces", "CRIT")
        found.append("kernel_recompiled")

    if not found:
        clean("kernel surface clean (or restricted)")
    return found

def scan_procs():
    found = []
    top = adb("top -b -n 1")
    cpu = adb("dumpsys cpuinfo")
    batt = adb("dumpsys batterystats")
    events = adb("logcat -d -b events -t 500")

    if re.search(r"\bapd\b", top) or re.search(r"\bapd\b", cpu) or "Proc apd" in batt:
        hit("apd leak", "CRIT")
        found.append("apd")
    if re.search(r"\bssh\.sh\b", top) or "ssh.sh" in events:
        hit("ssh.sh leak", "CRIT")
        found.append("ssh.sh")
    if re.search(r"\binotifyd\b", top) and "Proc inotifyd" in batt:
        hit("inotifyd leak", "CRIT")
        found.append("inotifyd")
    if re.search(r"PhantomProcessRecord.*:su/", events):
        hit("PhantomProcessRecord su", "CRIT")
        found.append("su_phantom")
    if re.search(r"Proc (kikiw|magisk|apatch)", batt):
        hit("root proc residue", "CRIT")
        found.append("root_proc")
    if re.search(r"commit_common_su|Untracked pid", events):
        hit("su phantom signal 9", "CRIT")
        found.append("su_phantom")

    if not found:
        clean("no root process residue")
    return found

def scan_root_bin():
    found = []
    root_paths = ["/system/bin/su", "/system/xbin/su", "/data/local/tmp/su", "/data/adb/su"]
    for p in root_paths:
        out = adb(f"ls -l {p} 2>/dev/null")
        if "root" in out or (out.strip() and "Permission denied" not in out):
            hit(f"root binary visible: {p}", "CRIT")
            found.append(f"root_bin_{p.split('/')[-1]}")
    return found

def scan_strings():
    found = []
    su_str = adb("strings /system/bin/su 2>/dev/null | head -n 50")
    if "commit_common_su" in su_str or "PhantomProcessRecord" in su_str or "apd" in su_str:
        hit("su strings detect", "CRIT")
        found.append("su_strings")
    return found

def scan_android11_15():
    found = []
    props = adb("getprop")
    if re.search(r"ro.build.version.sdk:[^1][0-9]+", props) or re.search(r"ro.build.version.release:[^1][0-5]\.", props):
        hit("Android 11-15 indicators", "CRIT")
        found.append("android_11_15")
    return found

def scan_extra():
    found = []
    artd = adb("logcat -d -t 100 artd:I *:S")
    if "me.yuki.folk" in artd and "base.odex" in artd:
        hit("artd odex residue", "CRIT")
        found.append("artd_odex")
    return found

